{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Selfrionette Device Manager",
  "version": "0.2.0-preview.1",
  "identifier": "dev.selfrionette.manager",
  "build": {
    "frontendDist": "../frontend",
    "windows": {
      "staticVCRuntime": true
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Selfrionette Device Manager",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 520,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": [
        {
          "identifier": "main-window-events",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:event:allow-listen",
            "core:event:allow-unlisten"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Xpotato.net",
    "homepage": "https://xpotato.net"
  }
}
