{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Selfrionette Device Manager",
  "version": "0.1.0",
  "identifier": "dev.selfrionette.manager",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Selfrionette Device Manager — Offline",
        "width": 1160,
        "height": 850,
        "minWidth": 850,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": []
    }
  },
  "bundle": {
    "active": false
  }
}
