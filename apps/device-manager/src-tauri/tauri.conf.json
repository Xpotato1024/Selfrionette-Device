{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Selfrionette Device Manager",
  "version": "0.1.0-preview.2",
  "identifier": "dev.selfrionette.manager",
  "build": {
    "frontendDist": "../frontend",
    "windows": {
      "staticVCRuntime": true
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Selfrionette Device Manager",
        "width": 1000,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": []
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Xpotato.net",
    "homepage": "https://xpotato.net"
  }
}
